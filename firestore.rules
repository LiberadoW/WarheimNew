rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules.
// Matches src/campaignHub/campaignService.js and the "lists" reads/writes in
// Builder.js, MyLists.js and Register.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function campaign(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }

    function isMember(campaignId) {
      return signedIn() && request.auth.uid in campaign(campaignId).members;
    }

    // The app's administrator may read every saved list and campaign
    // (read only; "Rozpiski graczy" in the app).
    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() == "wojtek.szemik@gmail.com";
    }

    // "Moje rozpiski": one document per user, private to that user.
    match /lists/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // A code only reveals which campaign to join; codes cannot be listed.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /campaigns/{campaignId} {
      function onlyMembershipChanges() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberNames']);
      }

      function isJoining() {
        return onlyMembershipChanges()
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members.toSet()
            == resource.data.members.toSet().union([request.auth.uid].toSet());
      }

      function isLeaving() {
        return onlyMembershipChanges()
          && request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.ownerId
          && request.resource.data.members.toSet()
            == resource.data.members.toSet().difference([request.auth.uid].toSet());
      }

      allow read: if (signedIn() && request.auth.uid in resource.data.members) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        || isJoining()
        || isLeaving()
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Each member uploads only their own roster; every member can read all.
      match /lists/{uid} {
        allow read: if isMember(campaignId) || isAdmin();
        allow create, update: if isMember(campaignId) && request.auth.uid == uid;
        allow delete: if signedIn()
          && (request.auth.uid == uid || campaign(campaignId).ownerId == request.auth.uid);
      }

      // Pairings and results. The organizer manages them; the two players
      // of a game can record it (one entry per game).
      match /games/{gameId} {
        allow read: if isMember(campaignId);
        allow create, delete: if signedIn()
          && campaign(campaignId).ownerId == request.auth.uid;
        allow update: if isMember(campaignId)
          && (campaign(campaignId).ownerId == request.auth.uid
            || request.auth.uid in resource.data.players);
      }
    }
  }
}
